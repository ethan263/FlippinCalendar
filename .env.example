# Supabase (https://supabase.com/dashboard/project/labvbngxfkzeepyyyjov/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://labvbngxfkzeepyyyjov.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Clerk
# Local / Development instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
# Production Frontend API host (auto-detected from pk_live_ if unset)
# NEXT_PUBLIC_CLERK_FAPI_HOST=clerk.flippincalendar.co.za
# Canonical app origin (metadataBase, PayFast redirects, sitemap)
# Production — www is canonical; apex redirects here:
NEXT_PUBLIC_APP_URL=https://www.flippincalendar.co.za
# Explicit allowlist (apex + www). Overrides NEXT_PUBLIC_APP_URL derivation:
# CLERK_AUTHORIZED_PARTIES=https://flippincalendar.co.za,https://www.flippincalendar.co.za
# Production webhook signing secret (differs from Development)
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ElevenLabs (server-only API key)
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_DEFAULT_AGENT_ID=agent_5101kyk31534e7bb4vp8v2x4dae3
# HMAC secret from ElevenLabs Agents → Settings → Webhooks (post-call)
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_hmac_secret
# Production webhook URL (register in ElevenLabs when cutting over):
# https://www.flippincalendar.co.za/api/webhooks/elevenlabs

# PayFast (sandbox or live — never commit real values)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_MODE=sandbox
# Webhooks use the canonical www origin in production (optional override for ngrok)
# NEXT_PUBLIC_WEBHOOKS_URL=https://your-ngrok-url.ngrok-free.app

# Billing renewal cron (Vercel Cron → /api/cron/billing-renewals)
CRON_SECRET=your_random_cron_secret

# Transactional email (renewal reminders — optional)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=billing@flippincalendar.co.za
