{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Cloudflare DNS for flippincalendar.co.za — Vercel app + Clerk Production. Keep Clerk/email CNAMEs DNS-only (grey cloud). Apex/www grey until Vercel verifies, then optional orange-cloud.",
  "zone": "flippincalendar.co.za",
  "architecture": {
    "dns_cdn_waf": "Cloudflare",
    "app_hosting": "Vercel (Next.js)",
    "auth": "Clerk Production instance ins_3H8qnDBcKY6852h5cV9BTnqJFT2",
    "data": "Supabase",
    "voice": "ElevenLabs"
  },
  "cloudflare_settings": {
    "ssl_mode": "full_strict",
    "always_use_https": true,
    "automatic_https_rewrites": true,
    "min_tls": "1.2"
  },
  "records": [
    {
      "type": "A",
      "name": "@",
      "content": "76.76.21.21",
      "proxied": true,
      "ttl": "auto",
      "note": "Vercel apex — orange cloud via Cloudflare"
    },
    {
      "type": "CNAME",
      "name": "www",
      "content": "cname.vercel-dns.com",
      "proxied": true,
      "ttl": "auto",
      "note": "Vercel www"
    },
    {
      "type": "CNAME",
      "name": "clerk",
      "content": "frontend-api.clerk.services",
      "proxied": false,
      "ttl": "auto",
      "note": "Clerk Frontend API — MUST stay DNS-only"
    },
    {
      "type": "CNAME",
      "name": "accounts",
      "content": "accounts.clerk.services",
      "proxied": false,
      "ttl": "auto",
      "note": "Clerk Accounts Portal — MUST stay DNS-only"
    },
    {
      "type": "CNAME",
      "name": "clkmail",
      "content": "mail.ioxqly7efr5z.clerk.services",
      "proxied": false,
      "ttl": "auto",
      "note": "Clerk email"
    },
    {
      "type": "CNAME",
      "name": "clk._domainkey",
      "content": "dkim1.ioxqly7efr5z.clerk.services",
      "proxied": false,
      "ttl": "auto",
      "note": "Clerk DKIM1"
    },
    {
      "type": "CNAME",
      "name": "clk2._domainkey",
      "content": "dkim2.ioxqly7efr5z.clerk.services",
      "proxied": false,
      "ttl": "auto",
      "note": "Clerk DKIM2"
    }
  ],
  "webhooks": {
    "payfast": "https://flippincalendar.co.za/api/webhooks/payfast",
    "elevenlabs": "https://flippincalendar.co.za/api/webhooks/elevenlabs",
    "setup": "CLOUDFLARE_API_TOKEN=... node scripts/setup-cloudflare-dns.mjs"
  },
  "google_oauth_callbacks": [
    "https://clerk.flippincalendar.co.za/v1/oauth_callback",
    "https://accounts.flippincalendar.co.za/v1/oauth_callback"
  ],
  "google_authorized_javascript_origins": [
    "https://flippincalendar.co.za",
    "https://www.flippincalendar.co.za",
    "https://clerk.flippincalendar.co.za",
    "https://accounts.flippincalendar.co.za"
  ]
}
